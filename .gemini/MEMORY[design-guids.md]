## 📊 MODELO DE DADOS (Conceitual)

```sql
-- Entregadores NÃO pertencem a uma loja
delivery_drivers (
    id UUID,
    name VARCHAR,
    status ENUM('disponivel', 'em_rota', 'offline'),
    current_lat DECIMAL,
    current_lng DECIMAL,
    -- SEM store_id fixo!
    -- Pode atender QUALQUER loja
);

-- Pedidos são segregados por loja
orders (
    id UUID,
    store_id UUID,  -- Cada pedido pertence a UMA loja
    driver_id UUID, -- Entregador atribuído (do pool)
    status ENUM('pending', 'ready_for_pickup', 'assigned', 'in_transit', 'delivered'),
);

-- Solicitação de busca (Loja solicita ao Pool)
pickup_requests (
    id UUID,
    order_id UUID,
    store_id UUID,          -- Quem está solicitando
    requested_at TIMESTAMP,
    assigned_driver_id UUID, -- Quem pegou do pool
    assigned_at TIMESTAMP,
);

-- Geo-Zones cobrem REGIÕES com múltiplas lojas
geo_zones (
    id UUID,
    name VARCHAR,
    center_lat DECIMAL,
    center_lng DECIMAL,
    radius_km DECIMAL,
    -- Monitora cobertura para TODAS as lojas na região
);
```

